# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
!.env.*.example
frontend/.env
!frontend/.env.example
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Raw / Large Datasets & Vector Stores (>100MB / Hugging Face cache)
data/raw/
*.sqlite3
*.sqlite3*
*.bak
*.bin
*.pickle
*.pkl
**/.cache/
**/vectors/

# Operating System & IDE
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
